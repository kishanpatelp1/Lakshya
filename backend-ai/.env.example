# API (unified backend — all routes served on one port)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/equity_research

# Redis (optional)
# REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# LLM
# Provider: ollama | deepseek | openai | groq
LLM_PROVIDER=ollama
# Global model override (optional). If unset, provider-specific default model is used.
# LLM_MODEL=deepseek-r1:8b
# Optional comma-separated discoverable model list for your own tooling/UI.
# LLM_MODEL_OPTIONS=deepseek-r1:8b,llama3.2,gemma2:9b,llama-3.3-70b-versatile,gpt-4o-mini
# Default temperature for chat model selection
LLM_TEMPERATURE=0.3

# Ollama
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek API (optional, use LLM_PROVIDER=deepseek)
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (optional, use LLM_PROVIDER=openai)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Groq API (optional, use LLM_PROVIDER=groq)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_API_KEY=gsk_...
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic Claude API (optional, use LLM_PROVIDER=claude)
# CLAUDE_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini API (optional, used for supplemental company enrichment)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Embeddings (Ollama nomic-embed-text)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# Observability
# SigNoz via Foundry: cd observability/pours/deployment && docker compose up -d
# UI: http://localhost:3301  |  OTLP gRPC: localhost:4317
OBSERVABILITY_ENABLED=true
OTEL_SERVICE_NAME=lakshya-backend
OTEL_SERVICE_VERSION=0.2.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# LangSmith / LangChain tracing
# Set to "true" to send LLM + chain traces to LangSmith.
# Create a free project at https://smith.langchain.com and grab your API key.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lakshya-backend
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here

# Deep multi-agent orchestration
WORKFLOW_RUNS_DIR=workflow_runs
DEEP_AGENT_MAX_STEPS=6

# Optional web search augmentation (used by WebSearchAgent)
# TAVILY_API_KEY=tvly-...

# ── External data API keys (optional) ──
# Financial Modeling Prep — https://financialmodelingprep.com/developer/docs/
# FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Federal Reserve Economic Data (FRED) — https://fredaccount.stlouisfed.org/apikeys
# FRED_API_KEY=your_fred_api_key_here

# NewsAPI — https://newsapi.org/register
# NEWS_API_KEY=your_newsapi_key_here

# NewsData.io — https://newsdata.io/register
# NEWSDATA_API_KEY=your_newsdata_api_key_here

# News NLP models (Hugging Face)
# Default is a balanced setup: finance-specific sentiment + lightweight zero-shot classifier.
# NEWS_SENTIMENT_MODEL=ProsusAI/finbert
# NEWS_ZERO_SHOT_MODEL=typeform/distilbert-base-uncased-mnli
# For lighter sentiment (non-finance tuned), you can use:
# NEWS_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english

# Upstox — https://developer.upstox.com/
# UPSTOX_API_KEY=your_upstox_api_key_here
# UPSTOX_API_SECRET=your_upstox_api_secret_here
# UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here

# Kite Connect (Zerodha) — https://developers.kite.trade/
# KITE_API_KEY=your_kite_api_key_here
# KITE_API_SECRET=your_kite_api_secret_here
# KITE_ACCESS_TOKEN=your_kite_access_token_here

# ── Commodity & Geopolitical Data APIs (Free Tiers) ──
# OilPriceAPI — https://www.oilpriceapi.com/ (50 req/month free forever)
# OIL_PRICE_API_KEY=your_oilpriceapi_key_here

# CommodityPriceAPI — https://commoditypriceapi.com/ (Unlimited free trial)
# COMMODITY_PRICE_API_KEY=your_commoditypriceapi_key_here

# GDELT Cloud — https://gdeltcloud.com/ (Free tier available)
# GDELT_API_KEY=your_gdeltcloud_key_here

# ── Auth / JWT ───────────────────────────────────────────────────────────
# REQUIRED: Generate a random secret for JWT signing.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# OTP
# OTP_EXPIRY_MINUTES=5
# OTP_LENGTH=6
# OTP_MAX_ATTEMPTS=3
# OTP_RATE_LIMIT_PER_HOUR=5

# SMTP (email OTP delivery). Leave empty for dev mode (OTP logged to console).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@lakshya.local
# SMTP_USE_TLS=true

# Cookie config (localhost — no HTTPS needed)
# For production (cross-domain), set COOKIE_SECURE=true, COOKIE_SAMESITE=none, COOKIE_DOMAIN=.yourdomain.com
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Frontend URL (used for OTP email links)
FRONTEND_URL=http://localhost:5173
